# ====== Server ======
# Cổng API (mặc định 8888). Host 0.0.0.0 khi chạy trong Docker/VPS.
PORT=8888
HOST=0.0.0.0
NODE_ENV=development
# Khi chạy sau reverse proxy (nginx/cloudflare) đặt true để lấy đúng IP client.
TRUST_PROXY=
# Danh sách origin được phép gọi API, ngăn cách bằng dấu phẩy.
# VD: https://your-frontend.vercel.app,http://localhost:3333
CORS_ORIGIN=http://localhost:3333

# ====== Database (PostgreSQL) ======
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=telemedicine_db
# Lưu ý: ký tự đặc biệt trong mật khẩu phải URL-encode (@ -> %40).
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/telemedicine_db?schema=public"

# ====== Redis (BullMQ) ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ====== Auth ======
JWT_SECRET=replace-with-a-long-random-secret

# ====== SMTP (gửi email: reset mật khẩu, thông báo) ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ====== SePay / VietQR (thanh toán) ======
# Tra cứu mã BIN ngân hàng: https://api.vietqr.io/v2/banks
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NUMBER=0000000000
VIETQR_ACCOUNT_NAME=NGUYEN VAN A
# Lấy trong SePay dashboard -> Tích hợp -> Cấu hình API Key. Để trống = webhook không bảo vệ (chỉ khi test).
SEPAY_WEBHOOK_API_KEY=
